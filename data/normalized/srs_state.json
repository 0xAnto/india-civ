   "unit": "per 1,000 live births",
   "type": "rate",
   "description": "SRS 2024. For smaller States/UTs the SRS gives the 3-year value 2022-24.",
   "higher_is": "worse"
  },
  "imr_rural": {
   "name": "Infant mortality rate, rural",
   "unit": "per 1,000 live births",
