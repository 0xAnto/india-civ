   "unit": "years",
   "type": "rate",
   "description": "As life_exp, males.",
   "higher_is": "better"
  },
  "life_exp_female": {
   "name": "Life expectancy at birth, female",
   "unit": "years",
   "type": "rate",
   "description": "As life_exp, females.",
   "higher_is": "better"
  }
